<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_bg">
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#2f2a25" android:maxLines="1" />
        <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#8c8478" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/slot0" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="0dp" android:layout_marginEnd="3dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
            android:background="@drawable/chip_bg">
            <ImageView android:id="@+id/dot0" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#2f2a25" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot1" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="0dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
            android:background="@drawable/chip_bg">
            <ImageView android:id="@+id/dot1" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#2f2a25" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="0dp" android:layout_marginEnd="3dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
            android:background="@drawable/chip_bg">
            <ImageView android:id="@+id/dot2" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#2f2a25" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot3" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="0dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
            android:background="@drawable/chip_bg">
            <ImageView android:id="@+id/dot3" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#2f2a25" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/slot4" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="0dp" android:layout_marginEnd="3dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
            android:background="@drawable/chip_bg">
            <ImageView android:id="@+id/dot4" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#2f2a25" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot5" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="0dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
            android:background="@drawable/chip_bg">
            <ImageView android:id="@+id/dot5" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name5" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#2f2a25" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/slot6" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="0dp" android:layout_marginEnd="3dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
            android:background="@drawable/chip_bg">
            <ImageView android:id="@+id/dot6" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name6" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#2f2a25" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot7" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="0dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
            android:background="@drawable/chip_bg">
            <ImageView android:id="@+id/dot7" android:layout_width="20dp" android:layout_height="20dp" />
            <TextView android:id="@+id/name7" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp" android:textColor="#2f2a25" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
